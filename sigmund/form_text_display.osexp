# This is a generic example script for a form_text_display item in OpenSesame
set description "A simple text display form"
# Response time out in milliseconds, or "infinite" for no timeout
set timeout infinite
# Three columns where the middle one is twice as large as the outer ones (sizes are relative)
set cols "1;2;1"
# Three equally sized rows (sizes are relative)
set rows "1;1;1"
set ok_text Start
set form_title "<b>Instructions</b>"
__form_text__
Some text, possibly including {variables}.
__end__
# Syntax: widget [column] [row] [colspan] [rowspan] [widget type] [**options]
# Important: the position and span of the widgets need to fit the cols and rows as specified above
widget 0 0 3 1 label text="{form_title}"
widget 0 1 3 1 label center=no text="{form_text}"
widget 1 2 1 1 button text="{ok_text}"