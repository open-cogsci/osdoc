define sequence trial_sequence
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run generate_stimuli always
	run fixation always
	run memory_array always
	run retention always
	run probe_display always
	run probe_response always
	run practice_feedback "practice == 1"
	run iti always
	run logger always

define sketchpad welcome
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=True text="Welcome to the Visual Working Memory Experiment!<br /><br />In this task you will see arrays of colored circles that you need to remember.<br /><br />Press any key to begin." x=0 y=0 z_index=0

