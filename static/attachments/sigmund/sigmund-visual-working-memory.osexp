---
API: 3
OpenSesame: 4.1.17
Platform: posix
---
set width 1024
set uniform_coordinates yes
set title "Visual Working Memory Task"
set synth_backend psycho
set subject_parity even
set subject_nr 0
set start experiment
set sound_sample_size -16
set sound_freq 48000
set sound_channels 2
set sound_buf_size 1024
set sampler_backend psycho
set round_decimals 2
set mouse_visible yes
set mouse_backend psycho
set keyboard_backend psycho
set height 768
set fullscreen no
set form_clicks no
set foreground white
set font_underline no
set font_size 18
set font_italic False
set font_family mono
set font_bold False
set experiment_path "/home/sebastiaan/git/osdoc/static/attachments"
set disable_garbage_collection False
set description "This experiment was auto-generated by SigmundAI"
set color_backend psycho
set clock_backend psycho
set canvas_backend psycho
set background "#3d3846"

define feedback block_feedback
	set reset_variables yes
	set duration keypress
	set description "Provides feedback to the participant"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=22 html=yes show_if=True text="Block {block_nr} of 3 complete!<br /><br />Your accuracy was {acc}%.<br />Your average response time was {avg_rt} ms.<br /><br />Take a short break if you like.<br />Press any key to continue." x=0 y=0 z_index=0

define loop block_loop
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set description "Repeatedly runs another item"
	set cycles 3
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 block_nr 1
	setcycle 1 block_nr 2
	setcycle 2 block_nr 3
	run block_sequence

define sequence block_sequence
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run reset_feedback always
	run trial_loop always
	run block_feedback "count_block_sequence < 2"

define feedback end_of_practice
	set reset_variables yes
	set duration keypress
	set description "Provides feedback to the participant"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=22 html=yes show_if=True text="Practice complete!<br /><br />Your accuracy was {acc}%.<br />Your average response time was {avg_rt} ms.<br /><br />The main experiment will now begin. No feedback will be given.<br /><br />Press any key to continue." x=0 y=0 z_index=0

define sequence experiment
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run welcome always
	run instructions always
	run practice_instruction always
	run practice_loop always
	run end_of_practice always
	run block_loop always
	run goodbye always

define sketchpad fixation
	set duration 500
	set description "Displays stimuli"
	draw fixdot color=white show_if=True style=default x=0 y=0 z_index=0

define inline_script generate_stimuli
	set description "Executes Python code"
	set _run ""
	___prepare__
	import random
	import math
	COLORS = ["red", "green", "blue", "yellow", "purple", "orange", "cyan", "pink", "white"]
	# select set_size unique colors for the memory array
	colors_list = random.sample(COLORS, set_size)
	# generate roughly evenly spaced angles around the ring with jitter
	base_angles = [i * (360.0 / set_size) for i in range(set_size)]
	angles = [a + random.uniform(-15, 15) for a in base_angles]
	random.shuffle(angles)
	eccentricity = 200
	pos_x = []
	pos_y = []
	for a in angles:
	    rad = math.radians(a)
	    r = eccentricity + random.uniform(-20, 20)
	    pos_x.append(int(round(r * math.cos(rad))))
	    pos_y.append(int(round(r * math.sin(rad))))
	# select which location will be probed
	probe_index = random.randrange(set_size)
	probe_x = pos_x[probe_index]
	probe_y = pos_y[probe_index]
	original_color = colors_list[probe_index]
	# determine probe color based on the change condition
	if change == "same":
	    probe_color = original_color
	else:
	    remaining_colors = [c for c in COLORS if c not in colors_list]
	    probe_color = random.choice(remaining_colors)
	# store as strings for logging purposes
	colors_str = ";".join(colors_list)
	pos_x_str = ";".join([str(v) for v in pos_x])
	pos_y_str = ";".join([str(v) for v in pos_y])
	__end__

define notepad getting_started
	set description "A simple notepad to document your experiment. This plug-in does nothing."
	___notepad__
	Visual Working Memory (Change Detection) Task.
	On each trial participants see a memory array of uniquely colored circles
	arranged around fixation (set size 2, 4 or 6). After a retention interval,
	a single probe circle appears at one of the original locations. The probe
	is either the SAME color as the original circle at that location, or a
	DIFFERENT color. Participants respond with 'a' (same) or 'l' (different).
	Trial timing: fixation 500 ms, memory array 1000 ms, retention 1000 ms,
	probe until response or 3000 ms timeout, ITI 500 ms.
	Practice block: 12 trials with trial-by-trial feedback.
	Main experiment: 3 blocks of 42 trials (7 per condition), no feedback,
	with an accuracy/RT summary screen after each block.
	__end__

define sketchpad goodbye
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=24 html=yes show_if=True text="Thank you for participating in this experiment!<br /><br />Your responses have been recorded.<br /><br />Press any key to exit." x=0 y=0 z_index=0

define sketchpad instructions
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=20 html=yes show_if=True text="On each trial you will briefly see several colored circles arranged around the center of the screen.<br /><br />Try to remember the color of every circle and its location.<br /><br />After a short delay, one location will be probed with a single circle.<br /><br />Decide whether the probe circle has the SAME color as the circle that was originally shown at that location, or a DIFFERENT color.<br /><br />Press 'A' if the color is the SAME.<br />Press 'L' if the color is DIFFERENT.<br /><br />Please respond as quickly and accurately as possible.<br /><br />Press any key to continue." x=0 y=0 z_index=0

define sketchpad iti
	set duration 500
	set description "Displays stimuli"

define logger logger
	set description "Logs experimental data"
	set auto_log yes

define inline_script memory_array
	set description "Executes Python code"
	___run__
	memory_canvas.show()
	clock.sleep(1000)
	__end__
	___prepare__
	memory_canvas = Canvas()
	memory_canvas.fixdot(x=0, y=0, color="white")
	for i in range(set_size):
	    memory_canvas.circle(x=pos_x[i], y=pos_y[i], r=30, color=colors_list[i], fill=True)
	__end__

define feedback practice_feedback
	set reset_variables yes
	set duration 750
	set description "Provides feedback to the participant"
	draw textline center=1 color=green font_bold=no font_family=mono font_italic=no font_size=32 html=yes show_if="correct == 1" text="Correct!" x=0 y=0 z_index=0
	draw textline center=1 color=red font_bold=no font_family=mono font_italic=no font_size=32 html=yes show_if="correct == 0 and response != None" text="Wrong!" x=0 y=0 z_index=0
	draw textline center=1 color=red font_bold=no font_family=mono font_italic=no font_size=32 html=yes show_if="response == None" text="Too slow!" x=0 y=0 z_index=0

define sketchpad practice_instruction
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=20 html=yes show_if=True text="We will start with a short practice block of 12 trials.<br /><br />During practice you will see feedback after every response.<br /><br />The main experiment will follow without feedback.<br /><br />Press any key to start the practice trials." x=0 y=0 z_index=0

define loop practice_loop
	set source_file ""
	set source table
	set repeat 1
	set order random
	set description "Repeatedly runs another item"
	set cycles 12
	set continuous no
	set break_if_on_first yes
	set break_if never
	setcycle 0 set_size 2
	setcycle 0 change same
	setcycle 0 practice 1
	setcycle 0 correct_response a
	setcycle 1 set_size 2
	setcycle 1 change same
	setcycle 1 practice 1
	setcycle 1 correct_response a
	setcycle 2 set_size 2
	setcycle 2 change different
	setcycle 2 practice 1
	setcycle 2 correct_response l
	setcycle 3 set_size 2
	setcycle 3 change different
	setcycle 3 practice 1
	setcycle 3 correct_response l
	setcycle 4 set_size 4
	setcycle 4 change same
	setcycle 4 practice 1
	setcycle 4 correct_response a
	setcycle 5 set_size 4
	setcycle 5 change same
	setcycle 5 practice 1
	setcycle 5 correct_response a
	setcycle 6 set_size 4
	setcycle 6 change different
	setcycle 6 practice 1
	setcycle 6 correct_response l
	setcycle 7 set_size 4
	setcycle 7 change different
	setcycle 7 practice 1
	setcycle 7 correct_response l
	setcycle 8 set_size 6
	setcycle 8 change same
	setcycle 8 practice 1
	setcycle 8 correct_response a
	setcycle 9 set_size 6
	setcycle 9 change same
	setcycle 9 practice 1
	setcycle 9 correct_response a
	setcycle 10 set_size 6
	setcycle 10 change different
	setcycle 10 practice 1
	setcycle 10 correct_response l
	setcycle 11 set_size 6
	setcycle 11 change different
	setcycle 11 practice 1
	setcycle 11 correct_response l
	run trial_sequence

define inline_script probe_display
	set description "Executes Python code"
	___run__
	probe_canvas.show()
	__end__
	___prepare__
	probe_canvas = Canvas()
	probe_canvas.circle(x=probe_x, y=probe_y, r=30, color=probe_color, fill=True)
	__end__

define keyboard_response probe_response
	set timeout 3000
	set flush_keyboard yes
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Collects keyboard responses"
	set correct_response "[correct_response]"
	set allowed_responses "a;l"

define reset_feedback reset_feedback
	set description "A very simple plug-in to reset feedback variables"

define sketchpad retention
	set duration 1000
	set description "Displays stimuli"
	draw fixdot color=white show_if=True style=default x=0 y=0 z_index=0

