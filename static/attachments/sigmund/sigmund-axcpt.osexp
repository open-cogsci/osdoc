---
API: 3
OpenSesame: 4.1.17
Platform: posix
---
set width 1024
set title "AX-CPT"
set subject_parity even
set subject_nr 0
set start experiment
set sound_sample_size -16
set sound_freq 48000
set sound_channels 2
set sound_buf_size 1024
set sampler_backend osweb
set round_decimals 2
set mouse_backend osweb
set keyboard_backend osweb
set jatos_uuid "e77d359e-76d1-4023-b352-2e8cf3d7cbab"
set height 768
set fullscreen no
set form_clicks no
set foreground white
set font_underline no
set font_size 32
set font_italic False
set font_family mono
set font_bold False
set experiment_path "/home/sebastiaan/git/osdoc/static/attachments/sigmund"
set disable_garbage_collection False
set description "This experiment was auto-generated by SigmundAI"
set color_backend osweb
set clock_backend osweb
set canvas_backend osweb
set background "#3d3846"

define feedback block_feedback
	set reset_variables no
	set duration keypress
	set description "Provides feedback to the participant"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=26 html=yes show_if=True text="Block finished!<br /><br />Accuracy: {acc}%<br />Average RT: {avg_rt} ms<br /><br />Press SPACE to continue." x=0 y=0 z_index=0

define loop block_loop
	set source_file ""
	set source table
	set repeat 1
	set order sequential
	set item block_sequence
	set description "Repeatedly runs another item"
	set cycles 2
	set continuous no
	set column_order block
	set break_if_on_first yes
	set break_if never
	setcycle 0 block 1
	setcycle 1 block 2
	run block_sequence

define sequence block_sequence
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run reset_feedback True
	run trial_loop True
	run block_feedback "block == 1"
	run break_screen True

define sketchpad break_screen
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=26 html=yes show_if=True text="Take a short break.<br /><br />Press SPACE when you are ready to continue to the next block." x=0 y=0 z_index=0

define sketchpad cue_display
	set duration 500
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=48 html=yes show_if=True text="{cue_type}" x=0 y=0 z_index=0

define sequence experiment
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run task_description True
	run welcome True
	run instructions True
	run practice_loop True
	run practice_to_main_transition True
	run block_loop True
	run goodbye True

define sketchpad fixation
	set duration 1000
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=48 html=yes show_if=True text="+" x=0 y=0 z_index=0

define sketchpad fixation_500
	set duration 500
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=48 html=yes show_if=True text="+" x=0 y=0 z_index=0

define sketchpad goodbye
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=28 html=yes show_if=True text="Thank you for participating!<br /><br />Press SPACE to exit." x=0 y=0 z_index=0

define sketchpad instructions
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=22 html=yes show_if=True text="On each trial you will first see a CUE letter, and shortly after a PROBE letter.<br /><br />- If the cue is 'A' and the probe is 'X', press the LEFT arrow key.<br />- For any other combination (AY, BX, BY), press the RIGHT arrow key.<br /><br />Example: A then X --&gt; press LEFT<br />Example: A then Y --&gt; press RIGHT<br />Example: B then X --&gt; press RIGHT<br />Example: B then Y --&gt; press RIGHT<br /><br />Please respond as quickly and accurately as possible.<br /><br />Press SPACE to start a practice block." x=0 y=0 z_index=0

define logger logger
	set description "Logs experimental data"
	set auto_log yes

define feedback practice_feedback
	set reset_variables no
	set duration 500
	set description "Provides feedback to the participant"
	draw textline center=1 color="{'green' if correct == 1 else 'red'}" font_bold=no font_family=mono font_italic=no font_size=26 html=yes show_if=True text="{'Correct!' if correct == 1 else 'Incorrect! Correct response: ' + correct_response}" x=0 y=0 z_index=0

define loop practice_loop
	set source_file ""
	set source table
	set repeat 1
	set order random
	set item practice_trial_sequence
	set description "Repeatedly runs another item"
	set cycles 40
	set continuous no
	set column_order "cue_type;probe_type;trial_type;correct_response"
	set break_if_on_first yes
	set break_if never
	setcycle 0 cue_type A
	setcycle 0 probe_type X
