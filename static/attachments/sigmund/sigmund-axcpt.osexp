define sketchpad practice_to_main_transition
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=26 html=yes show_if=True text="Practice complete!<br /><br />The main experiment will now begin.<br />Remember: LEFT for A-X, RIGHT for anything else.<br /><br />Press SPACE to continue." x=0 y=0 z_index=0

define sequence practice_trial_sequence
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run fixation True
	run cue_display True
	run fixation_500 True
	run probe_display True
	run probe_response True
	run practice_feedback True
	run fixation_500 True
	run logger True

define sketchpad probe_display
	set duration 0
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=48 html=yes show_if=True text="{probe_type}" x=0 y=0 z_index=0

define keyboard_response probe_response
	set timeout 1000
	set flush yes
	set event_type keypress
	set duration keypress
	set description "Collects keyboard responses"
	set correct_response "{correct_response}"
	set allowed_responses "left;right"

define reset_feedback reset_feedback
	set description "A very simple plug-in to reset feedback variables"

define notepad task_description
	set description "Full narrative description of the AX-CPT task. Documentation only, not part of the run sequence. See persistent notes for the complete text."

