define sequence trial_sequence
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run fixation True
	run cue_display True
	run fixation_500 True
	run probe_display True
	run probe_response True
	run fixation_500 True
	run logger True

define sketchpad welcome
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=mono font_italic=no font_size=28 html=yes show_if=True text="Welcome to this experiment!<br /><br />You will see pairs of letters on the screen.<br /><br />Press SPACE to continue." x=0 y=0 z_index=0

